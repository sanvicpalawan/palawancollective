# ============================================================
# Palawan Collective — environment template
# Copy to .env (git-ignored) and fill in real values.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
# Neon: copy the POOLED connection string from Neon → Connection Details
# (the host contains `-pooler`). Local dev: a plain Postgres URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional pool tuning (defaults shown). Keep `max` low for Neon lower plans.
#DB_POOL_MAX=10
#DB_IDLE_TIMEOUT_MS=10000
#DB_CONNECT_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Admin console (stealth /admin)
# ------------------------------------------------------------
# 4-digit passkey that unlocks the ops console (no login page exists).
ADMIN_PASSKEY=5309
# Long random string that signs the session JWT — REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------
# AI agents (Ops Console → Models)
# ------------------------------------------------------------
# OpenRouter API key (cloud models). Can also be pasted in the admin UI.
OPENROUTER_API_KEY=
# Ollama host (local models). Point at a machine that runs `ollama`.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------
# Public contact details (client-exposed)
# ------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=63XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
